[Unit]
Description=QCode Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qcode
Group=qcode
WorkingDirectory=/opt/qcode/apps/server
EnvironmentFile=/etc/qcode/server.env
ExecStart=/usr/bin/node /opt/qcode/apps/server/src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/qcode
UMask=0077

[Install]
WantedBy=multi-user.target
