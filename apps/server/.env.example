HOST=127.0.0.1
PORT=3100
DB_PATH=./data/qcode.sqlite
KEY_ENCRYPTION_SECRET=replace-with-64-hex-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
LOGIN_FAILURE_LIMIT=10
REQUEST_TIMEOUT_MS=180000
QUOTA_TIMEZONE=Asia/Shanghai
# Initial model/key are optional: configure them through the administrator page.
# UPSTREAM_BASE_URL=https://api.deepseek.com/v1
# UPSTREAM_MODEL=replace-with-provider-model-id
# PUBLIC_MODEL=qcode-model
# UPSTREAM_API_KEY=replace-with-provider-key
ADMIN_ALLOWED_IPS=
# Only list reverse proxies you control. Empty means forwarded headers are ignored.
TRUST_PROXY_CIDRS=
